#!/bin/bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

source "$PROJECT_ROOT/lib/common.sh"
source "$PROJECT_ROOT/lib/github.sh"
source "$PROJECT_ROOT/lib/git.sh"
source "$PROJECT_ROOT/lib/environment.sh"
source "$PROJECT_ROOT/lib/repository.sh"

CONFIG_DIR="$PROJECT_ROOT/config"

REPOSITORIES_CONFIG="$CONFIG_DIR/repositories.json"
ENVIRONMENTS_CONFIG="$CONFIG_DIR/environments.json"

WORKSPACE_ROOT="${WORKSPACE_ROOT:-$HOME/Documents/cpps-workspace}"

FEATURE_BRANCH=""
ENVIRONMENT=""
SOURCE_BRANCH=""

SELECTED_REPOSITORIES=()

CREATED_REPOSITORIES=()
REUSED_REPOSITORIES=()
MERGED_REPOSITORIES=()
FAILED_REPOSITORIES=()

validate_dependencies() {
    require_command "git"
    require_command "gh"
    require_command "jq"
}

validate_configuration() {
    [[ -f "$REPOSITORIES_CONFIG" ]] ||
        die "Repository configuration not found: $REPOSITORIES_CONFIG"

    [[ -f "$ENVIRONMENTS_CONFIG" ]] ||
        die "Environment configuration not found: $ENVIRONMENTS_CONFIG"

    jq empty "$REPOSITORIES_CONFIG" >/dev/null ||
        die "Invalid repository configuration JSON."

    jq empty "$ENVIRONMENTS_CONFIG" >/dev/null ||
        die "Invalid environment configuration JSON."
}

get_feature_branch() {
    local branch

    echo

    while true; do
        read -r -p "Enter feature branch name: " branch

        if [[ -z "$branch" ]]; then
            log_warn "Feature branch cannot be empty."
            continue
        fi

        if ! git_validate_branch_name "$branch"; then
            log_warn "Invalid Git branch name: $branch"
            continue
        fi

        FEATURE_BRANCH="$branch"
        break
    done

    log_success "Feature branch: $FEATURE_BRANCH"
}

create_workspace_root() {
    if ! mkdir -p "$WORKSPACE_ROOT"; then
        die "Unable to create workspace directory: $WORKSPACE_ROOT"
    fi
}

print_summary() {
    echo
    echo "========================================"
    echo " Workspace Summary"
    echo "========================================"
    echo

    printf "Environment    : %s\n" "$ENVIRONMENT"
    printf "Source branch  : %s\n" "$SOURCE_BRANCH"
    printf "Feature branch : %s\n" "$FEATURE_BRANCH"
    printf "Workspace      : %s\n" "$WORKSPACE_ROOT/$FEATURE_BRANCH"

    echo

    if [[ "${#CREATED_REPOSITORIES[@]}" -gt 0 ]]; then
        echo "Created:"
        printf '  - %s\n' "${CREATED_REPOSITORIES[@]}"
        echo
    fi

    if [[ "${#REUSED_REPOSITORIES[@]}" -gt 0 ]]; then
        echo "Reused:"
        printf '  - %s\n' "${REUSED_REPOSITORIES[@]}"
        echo
    fi

    if [[ "${#MERGED_REPOSITORIES[@]}" -gt 0 ]]; then
        echo "Merged with source:"
        printf '  - %s\n' "${MERGED_REPOSITORIES[@]}"
        echo
    fi

    if [[ "${#FAILED_REPOSITORIES[@]}" -gt 0 ]]; then
        echo "Failed:"
        printf '  - %s\n' "${FAILED_REPOSITORIES[@]}"
        echo
    fi
}

main() {
    validate_dependencies
    validate_configuration

    github_check_auth

    get_feature_branch

    select_environment

    select_repositories

    if [[ "${#SELECTED_REPOSITORIES[@]}" -eq 0 ]]; then
        die "No repositories selected."
    fi

    resolve_source_branch "${SELECTED_REPOSITORIES[@]}"

    create_workspace_root

    for repository in "${SELECTED_REPOSITORIES[@]}"; do
        process_repository "$repository" || true
    done

    print_summary

    if [[ "${#FAILED_REPOSITORIES[@]}" -gt 0 ]]; then
        exit 1
    fi

    echo
    log_success "Workspace setup completed successfully."
}

main "$@"